name: Build SPFx (react-directory)

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout main
        uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 1

      - name: Verify sample folder exists
        run: |
          ls -la
          ls -la samples/react-directory

      # ⚠️ SPFx 1.17.x => Node 16.x (ne 18!)
      - name: Use Node 16 for SPFx 1.17.x
        uses: actions/setup-node@v4
        with:
          node-version: '16.20.2'
          cache: 'npm'
          cache-dependency-path: samples/react-directory/package-lock.json

      # Stabil NPM config + SPFx kompat
      - name: NPM config for SPFx
        working-directory: samples/react-directory
        run: |
          npm config set legacy-peer-deps true
          npm config set registry https://registry.npmjs.org/
          npm config set fetch-timeout 600000
          npm config set fetch-retry-maxtimeout 600000
          npm config set prefer-online true

      # Telepítés (lockfile alapján). Ha net hiba van, egy retry.
      - name: Install (npm ci)
        working-directory: samples/react-directory
        run: |
          npm ci --no-audit --no-fund || npm ci --no-audit --no-fund

      - name: Clean & Bundle (SHIP)
        working-directory: samples/react-directory
        env:
          CI: "false"   # ne kezelje warningot hibaként
        run: |
          npx gulp clean
          npx gulp bundle --ship --verbose || echo "Ignoring non-zero exit due to warnings"
          echo "---- contents of release/manifests ----"
          ls -la release || true
          ls -la release/manifests || true

      # Csak akkor megyünk tovább, ha tényleg lett manifest
      - name: Ensure manifests exist
        working-directory: samples/react-directory
        run: |
          test -d release/manifests && test "$(ls -1 release/manifests | wc -l)" -gt 0 || (echo "Bundle did not emit release/manifests/*.json" && exit 1)

      - name: Package solution (SHIP)
        working-directory: samples/react-directory
        run: npx gulp package-solution --ship

      - name: Show output folder
        run: ls -la samples/react-directory/sharepoint/solution

      - name: Upload .sppkg
        uses: actions/upload-artifact@v4
        with:
          name: sharepoint-solution
          path: samples/react-directory/sharepoint/solution/*.sppkg
